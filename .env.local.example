APP_NAME=PapyrusPOS
APP_ENV=production
APP_KEY=<ISI_APP_KEY_VALID>
APP_DEBUG=false
APP_URL=https://<domain-pos-kamu>

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password-kuat>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=<domain-pos-kamu>
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=<smtp-port>
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password-baru>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<noreply@domain-kamu>
MAIL_FROM_NAME="Papyrus POS"

APP_MODE=local_branch
SYNC_ENABLED=true
SYNC_ROLE=sender
SYNC_TARGET_NAME=cloud
SYNC_CLOUD_PUSH_URL=https://<cloud-domain>/api/sync/push
SYNC_CLOUD_BOOTSTRAP_URL=https://<cloud-domain>/api/sync/bootstrap/master
SYNC_CLOUD_MASTER_PULL_URL=https://<cloud-domain>/api/sync/pull/master
SYNC_API_KEY=<sync-api-key-baru-panjang-random>
SYNC_ALLOWED_IPS=<ip-cloud-1>,<ip-cloud-2>
SYNC_RATE_LIMIT_PER_MINUTE=30

SYNC_HTTP_TIMEOUT=60
SYNC_HTTP_RETRY_ATTEMPTS=3
SYNC_HTTP_RETRY_SLEEP_MS=800
SYNC_BATCH_SIZE=300
SYNC_BOOTSTRAP_BATCH_SIZE=2000
SYNC_PULL_MASTER_AUTO=true
SYNC_PULL_MASTER_MODE=incremental
SYNC_PULL_MASTER_INTERVAL_MINUTES=1
SYNC_PULL_MASTER_CABANG_ID=0
SYNC_PULL_MASTER_TARGET_NAME=cloud_master
SYNC_PULL_BATCH_SIZE=300
SYNC_PULL_PARTIAL_MAX_RETRIES=3

POS_IZINKAN_STOK_NEGATIF=false
POS_VOID_OTP_MAX_ATTEMPTS=5
POS_VOID_OTP_DECAY_SECONDS=600
